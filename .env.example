# ── AI / Anthropic ────────────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com → API Keys → Create Key
# Copy this file to .env and paste your key below.
EXPO_PUBLIC_ANTHROPIC_KEY=sk-ant-api03-REPLACE_WITH_YOUR_KEY

# ── Optional: live stock prices (the price robot) ─────────────────────────────
# URL of the price-robot Worker (workers/price-robot), e.g.
# https://price-robot.<subdomain>.workers.dev, or http://127.0.0.1:8787 for
# `npm run dev` there. Not a secret: the API keys live only in the Worker.
# Unset = simulated prices from the January snapshot.
EXPO_PUBLIC_PRICE_API_URL=

# ── Optional: future backend proxy (set when you publish) ─────────────────────
EXPO_PUBLIC_CLAUDE_PROXY_URL=
