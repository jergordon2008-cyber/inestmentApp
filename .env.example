# ── AI / Anthropic ────────────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com → API Keys → Create Key
# Copy this file to .env and paste your key below.
EXPO_PUBLIC_ANTHROPIC_KEY=sk-ant-api03-REPLACE_WITH_YOUR_KEY

# ── Optional: Finnhub (live stock prices) ─────────────────────────────────────
# Free tier at: https://finnhub.io → Dashboard → API Keys
EXPO_PUBLIC_FINNHUB_KEY=

# ── Optional: future backend proxy (set when you publish) ─────────────────────
EXPO_PUBLIC_CLAUDE_PROXY_URL=
