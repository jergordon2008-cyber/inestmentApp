{
  "name": "price-robot",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker that refreshes stock prices (Alpaca primary, Finnhub cross-check) into Workers KV and serves them to the app.",
  "scripts": {
    "dev": "node scripts/write-dev-vars.mjs && wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "@types/node": "^22.20.5",
    "typescript": "~5.9.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
