# Local development against the Firebase emulators (npm run emulators).
# Copy to .env.local — Expo loads it automatically and it overrides .env.
# The project id MUST start with "demo-": the app refuses emulator mode
# otherwise, so local traffic can never reach the production project.
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=true
# 127.0.0.1 for web / iOS simulator; 10.0.2.2 for the Android emulator;
# your machine's LAN IP for a physical device.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# Placeholder values — the emulators accept anything here.
EXPO_PUBLIC_FIREBASE_API_KEY=demo-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-investiq.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-investiq
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-investiq.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
