rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Billing fields on users/{uid}. Only the Stripe functions write these
    // (functions/src/index.ts, Admin SDK — not subject to these rules).
    function billingFields() {
      return ['subscription', 'subscriptionStatus', 'subscriptionPlan',
              'subscriptionRenewsAt', 'subscriptionCancelAtPeriodEnd',
              'subscriptionUpdatedAt', 'subscriptionExpiresAt', 'stripeCustomerId'];
    }

    // A doc (before or after a write) that carries no billing state beyond
    // subscription 'free' or no subscription at all.
    function hasNoBillingState(data) {
      return !data.keys().hasAny(billingFields().removeAll(['subscription']))
        && data.get('subscription', 'free') == 'free';
    }

    // Full profile — private to the owner, readable by admin for the admin view.
    //
    // The owner can't set or change billing fields. The app saves the whole
    // profile with merge, so a save that repeats the stored values unchanged
    // is fine; only a write that changes one is refused. Two exceptions, both
    // only ever to 'free': a new profile may carry subscription 'free' (what
    // createNewUser sets), and so may a save onto a doc that has no
    // subscription yet (an emptied profile being rebuilt by onboarding, or a
    // profile older than the field). Delete is allowed only while the doc
    // holds no billing state, so a student can't wipe their stripeCustomerId.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && hasNoBillingState(request.resource.data);
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(billingFields().removeAll(['subscription']))
        && (request.resource.data.get('subscription', null) == resource.data.get('subscription', null)
            || (!('subscription' in resource.data) && request.resource.data.subscription == 'free'));
      allow delete: if isOwner(uid) && hasNoBillingState(resource.data);
    }

    // Full portfolio incl. trade history — same privacy model.
    match /portfolios/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid);
    }

    // Trade journal / reflections — same privacy model.
    match /journals/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid);
    }

    // Small denormalized doc powering the leaderboard. Any signed-in student
    // can read everyone's public stats (that's the point of a leaderboard),
    // but can only write their own.
    //
    // The four prediction counts (classroom board, Phase D) can't be removed
    // once present. App versions from before Phase D save this doc with a
    // full replace and don't know these fields, so without this an old copy
    // of the app left open would silently wipe them. Current versions write
    // with merge, which keeps stored fields, so they always pass. A doc that
    // never had the fields (student hasn't run the new version) is unaffected.
    // "Present" means the key exists; earliestCheckBackAt may be null.
    function keepsPredictionCounts() {
      return (!('predictionsWritten'  in resource.data) || 'predictionsWritten'  in request.resource.data)
          && (!('predictionsReviewed' in resource.data) || 'predictionsReviewed' in request.resource.data)
          && (!('reviewedOnTime'      in resource.data) || 'reviewedOnTime'      in request.resource.data)
          && (!('earliestCheckBackAt' in resource.data) || 'earliestCheckBackAt' in request.resource.data);
    }

    // What a public_stats doc may hold (S2). The owner still reports these
    // numbers, so the limits only stop impossible values: the paper
    // portfolio starts at $100,000, so a value of $0–$10M is a return of
    // −100% to +9,900%. Counts are whole numbers in a sane range, and the
    // review counts can't exceed what they count. Follow-up: calculate these
    // on the server (Cloud Function) and make the doc read-only to clients.
    function isIntIn(v, lo, hi) {
      return v is int && v >= lo && v <= hi;
    }
    function isNullOrNumberIn(v, lo, hi) {
      return v == null || (v is number && v >= lo && v <= hi);
    }
    function isValidPublicStats(d, uid) {
      return d.keys().hasOnly(['uid', 'displayName', 'totalValue', 'totalReturnPercent',
                               'lessonsCompletedCount', 'streak', 'currentTier',
                               'predictionsWritten', 'predictionsReviewed',
                               'reviewedOnTime', 'earliestCheckBackAt', 'updatedAt'])
        && d.uid == uid
        && d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 60
        && isNullOrNumberIn(d.get('totalValue', null), 0, 10000000)
        && isNullOrNumberIn(d.get('totalReturnPercent', null), -100, 9900)
        && isIntIn(d.get('lessonsCompletedCount', 0), 0, 200)
        && isIntIn(d.get('streak', 0), 0, 3660)
        && isIntIn(d.get('currentTier', 1), 1, 3)
        && isIntIn(d.get('predictionsWritten', 0), 0, 10000)
        && isIntIn(d.get('predictionsReviewed', 0), 0, d.get('predictionsWritten', 0))
        && isIntIn(d.get('reviewedOnTime', 0), 0, d.get('predictionsReviewed', 0))
        && (d.get('earliestCheckBackAt', null) == null
            || (d.earliestCheckBackAt is string && d.earliestCheckBackAt.size() <= 40))
        && (d.get('updatedAt', null) == null
            || (d.updatedAt is string && d.updatedAt.size() <= 40));
    }

    match /public_stats/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid) && isValidPublicStats(request.resource.data, uid);
      allow update: if isOwner(uid) && keepsPredictionCounts()
        && isValidPublicStats(request.resource.data, uid);
      // No client delete: delete + re-create would drop the prediction counts.
      allow delete: if false;
    }

    // ── Classrooms ──────────────────────────────────────────────────────
    // A classroom doc carries its own roster (memberIds/members), its
    // teacher list (teacherIds) and its join code. Every rule below is
    // evaluated against those fields on the document itself.
    //
    //   read   — enrolled members only (uid in memberIds), plus admin. The
    //            client's "my classrooms" query filters memberIds
    //            array-contains uid, which satisfies this per document.
    //   create — the creator must be the sole teacher AND sole member of
    //            the new doc, and the code must match the code alphabet
    //            (see /classroom_codes). Nobody can create a classroom on
    //            someone else's behalf or seed it with other members.
    //   update — three narrow shapes, each checked via affectedKeys() so
    //            nothing outside the named fields can change:
    //            (a) self-join: a signed-in NON-member appends exactly their
    //                own uid to memberIds and exactly one member entry
    //                carrying their uid with role 'student'.
    //            (b) teacher edit: a uid in teacherIds changes content
    //                fields only. code / teacherIds / memberIds / members
    //                are not in that list, so they are immutable after
    //                creation — no self-promotion, no roster edits.
    //            (c) member completion: an enrolled member may change only
    //                `assignments` (the Mark Complete button). Known
    //                residual: a member could forge another member's
    //                completion. Closing that means moving completions to
    //                a subcollection (Option B, deferred).
    //   delete — never from the client.
    function isClassroomMember() {
      return isSignedIn() && request.auth.uid in resource.data.memberIds;
    }
    function isClassroomTeacher() {
      return isSignedIn() && request.auth.uid in resource.data.teacherIds;
    }
    function changesOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function isValidClassCode(code) {
      // 5 chars, no I / O / 0 / 1 (unambiguous when read aloud in class).
      // Mirrors CODE_ALPHABET in src/services/classroomStore.ts.
      return code is string && code.matches('^[A-HJ-NP-Z2-9]{5}$');
    }
    match /classrooms/{classId} {
      allow read: if isClassroomMember() || isAdmin();

      allow create: if isSignedIn()
        && request.resource.data.teacherIds == [request.auth.uid]
        && request.resource.data.memberIds == [request.auth.uid]
        && isValidClassCode(request.resource.data.code);

      // (a) self-join
      allow update: if isSignedIn()
        && !(request.auth.uid in resource.data.memberIds)
        && changesOnly(['memberIds', 'members'])
        && request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid])
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.members[resource.data.members.size()].id == request.auth.uid
        && request.resource.data.members[resource.data.members.size()].role == 'student';

      // (b) teacher edit
      allow update: if isClassroomTeacher()
        && changesOnly(['name', 'description', 'subject', 'gradeLevel', 'assignments', 'announcements']);

      // (c) member completion
      allow update: if isClassroomMember() && changesOnly(['assignments']);

      allow delete: if false;
    }

    // Join-code index: classroom_codes/{CODE} → { classId, teacherId }.
    // Lets a non-member resolve a code to a classroom id WITHOUT being able
    // to read or list any classroom document (the roster stays private).
    // The code is the document id, so two classrooms can never share one:
    // a second create with the same code is an update, which is denied.
    // Only the classroom's own teacher can create the entry, and it must
    // point at a classroom (written in the same batch — hence getAfter)
    // whose code matches and whose teacherIds contains the caller.
    // `get` only: a code must be known to be looked up. `list` is denied so
    // nobody can enumerate every classroom's join code.
    match /classroom_codes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && isValidClassCode(code)
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.classId is string
        && getAfter(/databases/$(database)/documents/classrooms/$(request.resource.data.classId)).data.code == code
        && request.auth.uid in getAfter(/databases/$(database)/documents/classrooms/$(request.resource.data.classId)).data.teacherIds;
      allow update, delete: if false;
    }

    // Admin allow-list — presence of a doc here grants admin rights.
    // Never writable from the client; only set via Firebase console/CLI.
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Real trade activity feed (symbol/action/name only, no amounts).
    // Any signed-in student can read the feed; a student can only create
    // events attributed to themselves, and events are immutable.
    match /activity/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Weekly challenge join records — one doc per (challenge, student) pair.
    // Real participant counts come from counting these, not a fake number.
    match /challenge_joins/{joinId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Forum posts — any signed-in student can read; a student can only
    // create posts attributed to themselves, and posts are immutable once
    // created (no editing/deleting from the client for MVP simplicity).
    match /forum_posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Analytics events — write-only from the client (a student can only
    // create events attributed to themselves, never read anyone's,
    // including their own — this is telemetry, not a feature). Only admins
    // can read, for the internal analytics dashboard. Immutable once written.
    match /analytics_events/{eventId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
